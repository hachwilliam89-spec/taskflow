# Copie ce fichier en ".env" et remplis les vraies valeurs.
# ".env" est ignoré par git (voir .gitignore) — jamais commité.
# Ce fichier ".env.example", lui, EST commité : c'est la doc vivante des
# variables que le projet attend, et env.validation.ts (Zod) fait respecter
# ce contrat au démarrage.

# --- Base de données ---
# Format : postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL="postgresql://taskflow_user:taskflow_dev_password@localhost:5433/taskflow"

# --- Serveur ---
NODE_ENV=development
PORT=3001

# --- CORS ---
# Origine(s) autorisée(s) à appeler l'API depuis un navigateur.
# Plusieurs valeurs séparées par des virgules, ex: "http://localhost:4200,https://app.taskflow.com"
CORS_ORIGIN=http://localhost:4200

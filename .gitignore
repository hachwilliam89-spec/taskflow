# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
# (sans "/" devant : ignore .idea/ à N'IMPORTE QUEL niveau du projet, pas
# seulement à la racine — utile ici puisque WebStorm en crée un par
# sous-dossier ouvert, ex: apps/frontend/.idea/)
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# environment variables (contient des secrets, ne jamais commiter)
.env
.env.*
!.env.example

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

# client Prisma généré automatiquement (régénéré via `pnpm exec prisma generate`)
/generated
